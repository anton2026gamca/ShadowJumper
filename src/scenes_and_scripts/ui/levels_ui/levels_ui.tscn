grow_vertical = 2
theme = ExtResource("2_nhhd0")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "Mushrooms glow with that energy, but their light is not good. If you touch it, it shocks you."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="Message4" type="RichTextLabel" parent="Story/Intro"]
visible = false

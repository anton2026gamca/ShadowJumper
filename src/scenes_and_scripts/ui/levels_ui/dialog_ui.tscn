grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "The deeper you go, the stranger the night feels. The mushrooms are everywhere, [color=yellow]glowing[/color] stronger."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="Message2" type="RichTextLabel" parent="DarkerForest"]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.25
anchor_top = 0.25
anchor_right = 0.75
anchor_bottom = 0.75
offset_left = -0.5
offset_right = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "You can feel the energy inside them, it's the same as the energy inside you. Maybe that is why they hurt you."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="Message3" type="RichTextLabel" parent="DarkerForest"]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.25
anchor_top = 0.25
anchor_right = 0.75
anchor_bottom = 0.75
offset_left = -0.5
offset_right = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true

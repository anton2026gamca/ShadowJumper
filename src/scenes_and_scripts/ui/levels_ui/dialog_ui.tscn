[node name="Message1" type="RichTextLabel" parent="Intro"]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.25
anchor_top = 0.25
anchor_right = 0.75
anchor_bottom = 0.75
offset_left = -0.5
offset_right = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "A long time ago, people wanted power from deep inside the earth. They dug too far, and they broke [color=purple]something very old[/color]."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="Message2" type="RichTextLabel" parent="Intro"]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.25
anchor_top = 0.25
anchor_right = 0.75
anchor_bottom = 0.75
offset_left = -0.5
offset_right = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "[color=yellow]Strange energy[/color] came out and changed the world forever. Now the night is not safe anymore."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="Message3" type="RichTextLabel" parent="Intro"]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.25
anchor_top = 0.25
anchor_right = 0.75
anchor_bottom = 0.75
offset_left = -0.5
offset_right = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "Mushrooms glow with that energy, but their light is not good. If you touch it, it shocks you."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="Message4" type="RichTextLabel" parent="Intro"]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.25
anchor_top = 0.25
anchor_right = 0.75
anchor_bottom = 0.75
offset_left = -0.5
offset_right = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/bold_italics_font_size = 18
theme_override_font_sizes/italics_font_size = 18
theme_override_font_sizes/mono_font_size = 18
theme_override_font_sizes/normal_font_size = 18
theme_override_font_sizes/bold_font_size = 18
bbcode_enabled = true
text = "From that broken energy you were born,
a [color=orange]small orange something[/color].
All you know is that the nature wants to get rid of you."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="Animals" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Message1" type="RichTextLabel" parent="Animals"]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.25
anchor_top = 0.25
anchor_right = 0.75
anchor_bottom = 0.75
offset_left = -0.5
offset_right = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "The animals of the forest are not normal anymore. Foxes, wolves, and boars attack everything they see."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="Message2" type="RichTextLabel" parent="Animals"]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.25
anchor_top = 0.25
anchor_right = 0.75
anchor_bottom = 0.75
offset_left = -0.5
offset_right = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_t18u5")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "It’s like they want to erase the spark inside you. You don’t understand them, but you know you have to survive."
horizontal_alignment = 1
vertical_alignment = 1
visible_characters_behavior = 1

[node name="DarkerForest" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Message1" type="RichTextLabel" parent="DarkerForest"]
visible = false

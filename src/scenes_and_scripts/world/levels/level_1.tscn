[sub_resource type="Resource" id="Resource_lbqyf"]
script = ExtResource("9_lbqyf")
message = "Hi, I finally found you! We need your help! Let me tell you what happened [color=green]deep in the forest[/color]."
metadata/_custom_type_script = "uid://dfa7rp0fl76u0"

[sub_resource type="Resource" id="Resource_sxcxt"]
script = ExtResource("9_lbqyf")
message = "A long time ago, people wanted power from deep inside the earth. They dug too far, and they broke [color=purple]something very old[/color]."
metadata/_custom_type_script = "uid://dfa7rp0fl76u0"

[sub_resource type="Resource" id="Resource_15ffy"]
script = ExtResource("9_lbqyf")
message = "[color=yellow]Strange energy[/color] came out and changed the world forever. Now the night is not safe anymore."
metadata/_custom_type_script = "uid://dfa7rp0fl76u0"

[sub_resource type="Resource" id="Resource_css43"]
script = ExtResource("9_lbqyf")
message = "Mushrooms got gigantic and glow with that energy, but their light is not good."
metadata/_custom_type_script = "uid://dfa7rp0fl76u0"

[sub_resource type="Resource" id="Resource_gyv5q"]
script = ExtResource("9_lbqyf")
message = "From that broken energy you were born, a [color=orange]small orange guy[/color]."
metadata/_custom_type_script = "uid://dfa7rp0fl76u0"

[sub_resource type="Resource" id="Resource_x3vl5"]
script = ExtResource("9_lbqyf")
message = "For some reason, the energy can't control you, unlike us. That's why we need you! Please save the world and stop whatever is there!"
metadata/_custom_type_script = "uid://dfa7rp0fl76u0"

[sub_resource type="Resource" id="Resource_mwxj1"]

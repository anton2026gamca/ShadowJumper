; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shadow Jumper"
run/main_scene="uid://cgnkbfbtrhkl8"
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="uid://5uggglelyu6l"
config/icon="uid://d3tvi8n1gvnj"

[autoload]

Progress="*res://scenes_and_scripts/progress.gd"
LevelLoader="*res://scenes_and_scripts/world/level_loader/level_loader.tscn"
Music="*res://scenes_and_scripts/music.tscn"
Helpers="*res://scenes_and_scripts/helpers/helpers.gd"
Settings="*res://scenes_and_scripts/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=5
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Shadow Jumper"

[editor]

movie_writer/movie_file="C:/Users/anton/Documents/Godot/ShadowJumper/src/export/video/video.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://assets/": "orange",
"res://export/": "yellow",
"res://scenes_and_scripts/": "green"
}

